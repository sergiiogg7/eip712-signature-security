# RPC endpoint of the target network (Sepolia, Anvil, ...)
RPC_URL=
# Private key of the deployer. Never commit a real value.
PRIVATE_KEY=0x...
# Contract owner: can change the authorizer and revoke users (use a multisig on real networks)
OWNER=0x...
# Account (EOA or ERC-1271 contract) whose signatures authorize users
AUTHORIZER=0x...
